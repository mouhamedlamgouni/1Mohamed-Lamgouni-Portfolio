  "narrative": {
    "northStar": "A composed selection of identity, print and digital work",
    "overview": "The existing direction contract supplies this north star. Deep slate, clear neutral text, amber punctuation, self-hosted Geist and intentional whitespace frame the work. The interface is restrained, with broad type hierarchy and open project metadata.\n\nRounded media and pill actions provide a consistent form language. Tonal surfaces and fine dividers establish depth; small lifts, image zooms and arrow rotation make interaction visible. These are extracted implementation decisions, not a new visual proposal.",
    "keyCharacteristics": [
      "User-pinned Geist typography.",
      "Slate and neutral themes with one amber interface accent.",
      "Rounded media, pill actions and open metadata.",
      "Responsive staggered work grid.",
      "Restrained motion with visible keyboard focus and reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Semantic Theme Rule",
        "body": "Apply the active theme's matching background, text, muted, line, accent and on-accent roles together.",
        "section": "colors"
      },
      {
        "name": "The Pinned Font Rule",
        "body": "Use self-hosted Geist for the interface, retaining the established weights and sans-serif fallback.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do preserve user-pinned Geist and its self-hosted Latin weight imports.",
      "Do apply complete semantic token sets when switching themes.",
      "Do use 14px media corners and pill action silhouettes.",
      "Do collapse the staggered work grid to one column without card offsets on mobile.",
      "Do retain accent focus outlines, reduced-motion handling and native dialog keyboard behavior.",
      "Do label placeholder media truthfully."
    ],
    "donts": [
      "Don't promote individual cover wordmark sizes or artwork palettes into global tokens.",
      "Don't invent shadow scales, color ramps, inputs or component states absent from the source.",
      "Don't hide availability entirely on mobile when the configured status is available."
